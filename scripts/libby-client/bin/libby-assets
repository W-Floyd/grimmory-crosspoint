#!/usr/bin/env bash
# The per-version asset list, in one place because three scripts need to agree on it.
#
# Paths are relative to https://libbyapp.com/dewey-<version>/. Only main.js is load-bearing for our
# purposes; the other two are here because they are cheap and they answer questions the bundle does
# not. en-US.js carries the user-facing strings, which is the fastest way to tell what a release
# changed. main.css dates a release when nothing else does.
LIBBY_ASSETS=(
  "src/main.js"
  "inc/str/en-US.js"
  "css/main.css"
)

# What a browser looks like: the same rule as FirefoxVersion on the server — the newest Firefox major
# released at least 7 days ago, per Mozilla's release history, never below the built-in version.
LIBBY_FIREFOX_BUILT_IN=157
LIBBY_FIREFOX="$(curl -fsS --max-time 20 https://product-details.mozilla.org/1.0/firefox_history_major_releases.json 2>/dev/null \
  | jq -r --arg cutoff "$(date -u -v-7d +%F 2>/dev/null || date -u -d '7 days ago' +%F)" \
      '[to_entries[] | select(.key | test("^[0-9]+\\.0$")) | select(.value <= $cutoff) | .key | rtrimstr(".0") | tonumber] | max // empty' \
      2>/dev/null || true)"
if [[ -z "$LIBBY_FIREFOX" || "$LIBBY_FIREFOX" -lt "$LIBBY_FIREFOX_BUILT_IN" ]]; then
  LIBBY_FIREFOX="$LIBBY_FIREFOX_BUILT_IN"
fi
LIBBY_UA="Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:${LIBBY_FIREFOX}.0) Gecko/20100101 Firefox/${LIBBY_FIREFOX}.0"

LIBBY_BASE="https://libbyapp.com"
