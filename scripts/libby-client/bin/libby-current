#!/usr/bin/env bash
# What version of the Libby web client is live right now, and can we speak as it?
#
# The version is not published anywhere official. It is visible because the app loads its own assets
# from a versioned directory — /dewey-22.1.1/src/main.js — so the index page names it in every build.
#
# Exit status is the point: 0 when it is supported, 1 when it is not. That makes this usable from a
# check rather than only by eye.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$here/libby-assets"

live="$(curl -fsS --max-time 30 -A "$LIBBY_UA" "$LIBBY_BASE/" \
        | grep -oE 'dewey-[0-9]+\.[0-9]+\.[0-9]+' | sort -u | head -1 | cut -d- -f2)"
if [[ -z "$live" ]]; then
  echo "could not read a version from $LIBBY_BASE/ — the page layout may have changed" >&2
  exit 2
fi

profiles="$here/../../../backend/src/main/java/org/booklore/service/overdrive/LibbyClientProfiles.java"
supported="$(grep -oE 'new LibbyClientProfile\("[^"]+"' "$profiles" 2>/dev/null | cut -d'"' -f2 | tr '\n' ' ' || true)"

echo "live:       $live"
echo "supported:  ${supported:-<not found>}"

archived="$here/../versions/$live"
if [[ ! -d "$archived" ]]; then
  echo
  echo "not archived yet — run: $here/libby-fetch $live"
  echo "  (old versions are NOT kept on the server; once it rolls, this one is gone for good)"
fi

if [[ " $supported " == *" $live "* ]]; then
  exit 0
fi
echo
echo "UNSUPPORTED: Grimmory stops all OverDrive traffic until $live is added to LibbyClientProfiles."
exit 1
